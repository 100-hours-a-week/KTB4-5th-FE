#!/usr/bin/env sh

set -u

run_check() {
  check_name="$1"
  log_file="$(mktemp "${TMPDIR:-/tmp}/ktb4-5th-${check_name}.XXXXXX")"

  if pnpm "$check_name" >"$log_file" 2>&1; then
    rm -f "$log_file"
    return 0
  fi

  node scripts/record-troubleshooting.mjs "$check_name" "$log_file"
  cat "$log_file"
  rm -f "$log_file"

  echo "pre-commit: pnpm $check_name failed; troubleshooting log was saved."
  exit 1
}

run_check lint
run_check test
